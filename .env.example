# Copy this file to .env and fill in your values

SECRET_KEY=django-insecure-rabit-dev-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Moyasar Payment Gateway ───────────────────────────────────────────────
# احصل على مفاتيحك من: https://dashboard.moyasar.com
# اتركهما فارغَين للعمل بالوضع التجريبي (بدون دفع حقيقي)
MOYASAR_PUBLISHABLE_KEY=your-moyasar-publishable-key-here
MOYASAR_SECRET_KEY=your-moyasar-secret-key-here
SITE_URL=http://127.0.0.1:8000

# ─── Email ─────────────────────────────────────────────────────────────────
# (leave as-is for local testing — only needed for email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=RABIT <your-email@gmail.com>
