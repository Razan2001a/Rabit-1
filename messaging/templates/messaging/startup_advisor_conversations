{% extends 'dashboard_base.html' %}
{% block title %}محادثات مع المستشارين{% endblock %}

{% block content %}
<section class="page-shell" style="max-width:760px;margin:0 auto;padding:24px">

  <div style="margin-bottom:20px">
    <h2 style="font-size:18px;font-weight:700;color:#1a1a2e;margin-bottom:4px">
      محادثات مع المستشارين
    </h2>
    <p style="font-size:13px;color:#6b7280">شركة ناشئة ↔ مستشار</p>
  </div>

  {% if convos %}
    <div style="display:flex;flex-direction:column;gap:10px">
      {% for c in convos %}
      <a href="{% url 'messaging:startup_advisor_chat' c.advisor.pk %}"
         style="background:#fff;border:1px solid #e8e8f0;border-radius:12px;
                padding:16px 20px;display:flex;align-items:center;gap:14px;
                text-decoration:none;transition:box-shadow .15s,border-color .15s"
         onmouseover="this.style.boxShadow='0 4px 16px rgba(79,70,229,.1)';this.style.borderColor='#c7d2fe'"
         onmouseout="this.style.boxShadow='none';this.style.borderColor='#e8e8f0'">

        <div style="width:44px;height:44px;border-radius:50%;background:#f0fdf4;
                    display:flex;align-items:center;justify-content:center;
                    font-size:17px;font-weight:700;color:#166534;flex-shrink:0">
          {{ c.advisor.user.first_name|first|default:c.advisor.user.username|first|upper }}
        </div>

        <div style="flex:1;min-width:0">
          <div style="font-size:15px;font-weight:600;color:#1a1a2e;margin-bottom:2px">
            {{ c.advisor.user.get_full_name|default:c.advisor.user.username }}
          </div>
          <div style="font-size:13px;color:#6b7280">
            {{ c.advisor.get_specialty_display }} · {{ c.messages.count }} رسالة
          </div>
        </div>

        {% if c.is_closed %}
          <span style="background:#f3f4f6;color:#6b7280;font-size:11px;font-weight:600;
                       padding:3px 10px;border-radius:12px">منتهية</span>
        {% else %}
          <span style="background:#dcfce7;color:#166534;font-size:11px;font-weight:600;
                       padding:3px 10px;border-radius:12px">نشطة</span>
        {% endif %}

        <i class="ti ti-chevron-left" style="color:#d1d5db;font-size:18px"></i>
      </a>
      {% endfor %}
    </div>

  {% else %}
    <div style="text-align:center;padding:64px 24px;color:#9ca3af">
      <i class="ti ti-school" style="font-size:52px;display:block;
                                      margin-bottom:16px;opacity:.35"></i>
      <p style="font-size:15px;color:#6b7280;font-weight:500">
        لا توجد محادثات بعد
      </p>
    </div>
  {% endif %}

</section>
{% endblock %}
